{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "show-time",
  "cleanUrls": true,
  "outputDirectory": "frontend",
  "headers": [
    {
      "source": "/assets/backgrounds/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/summary.html", "destination": "/summary", "permanent": true },
    { "source": "/schedule.html", "destination": "/schedule", "permanent": true },
    { "source": "/team.html", "destination": "/team", "permanent": true },
    { "source": "/files.html", "destination": "/files", "permanent": true },
    { "source": "/settings.html", "destination": "/settings", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/summary",
      "destination": "/app"
    },
    {
      "source": "/schedule",
      "destination": "/app"
    },
    {
      "source": "/team",
      "destination": "/app"
    },
    {
      "source": "/files",
      "destination": "/app"
    },
    {
      "source": "/settings",
      "destination": "/app"
    },
    {
      "source": "/api/:path*",
      "destination": "https://t-show-api.onrender.com/api/:path*"
    }
  ]
}
