{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "show-time",
  "cleanUrls": true,
  "outputDirectory": "frontend",
  "headers": [
    {
      "source": "/assets/backgrounds/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://sdk.mercadopago.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self'; connect-src 'self' https://*.r2.cloudflarestorage.com https://*.supabase.co https://api.mercadopago.com https://t-show-api.onrender.com; frame-src https://*.mercadopago.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self' https://*.mercadopago.com https://*.flow.cl; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/summary.html", "destination": "/summary", "permanent": true },
    { "source": "/metrics.html", "destination": "/metrics", "permanent": true },
    { "source": "/schedule.html", "destination": "/schedule", "permanent": true },
    { "source": "/team.html", "destination": "/team", "permanent": true },
    { "source": "/files.html", "destination": "/files", "permanent": true },
    { "source": "/settings.html", "destination": "/settings", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/app"
    },
    {
      "source": "/summary",
      "destination": "/app"
    },
    {
      "source": "/metrics",
      "destination": "/app"
    },
    {
      "source": "/schedule",
      "destination": "/app"
    },
    {
      "source": "/team",
      "destination": "/app"
    },
    {
      "source": "/files",
      "destination": "/app"
    },
    {
      "source": "/settings",
      "destination": "/app"
    },
    {
      "source": "/command-center",
      "destination": "/command-center.html"
    },
    {
      "source": "/incidents",
      "destination": "/incidents.html"
    },
    {
      "source": "/teleprompter",
      "destination": "/teleprompter.html"
    },
    {
      "source": "/guest",
      "destination": "/guest.html"
    },
    {
      "source": "/invite",
      "destination": "/invite.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://t-show-api.onrender.com/api/:path*"
    }
  ]
}
