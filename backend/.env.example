# Puerto de escucha (Render lo asigna automáticamente)
PORT=3000

# Entorno de ejecución
NODE_ENV=production

# Origen permitido para CORS (reemplazar con el dominio de tu frontend en Vercel, ej: https://show-time.vercel.app o *)
CORS_ORIGIN=*

# Directorio de almacenamiento de datos JSON
DATA_DIR=./data
