# ===============================================
# SHOW TIME - VARIABLES DE ENTORNO PARA RENDER
# Desarrollado por BaseAndes Software (https://www.baseandes.com/)
# ===============================================

# Puerto de escucha (Render lo asigna automáticamente)
PORT=3000

# Entorno de ejecución
NODE_ENV=production

# Origen permitido para CORS (reemplazar con el dominio de tu frontend en Vercel, ej: https://show-time.vercel.app o *)
CORS_ORIGIN=*

# Directorio de almacenamiento de datos JSON (legacy — se retira en la Fase 3 de la migración a Supabase)
DATA_DIR=./data

# ===============================================
# SUPABASE (base de datos)
# ===============================================
# URL del proyecto Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key — SECRETA, nunca exponerla al frontend (Project Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=

# ===============================================
# AUTENTICACIÓN (usuario + PIN)
# ===============================================
# Clave para firmar los JWT de acceso. Genera algo largo y aleatorio, ej: openssl rand -hex 32
JWT_SECRET=
# Clave para firmar los refresh tokens (puede ser distinta a JWT_SECRET para rotar independiente)
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Rondas de bcrypt para hashear el PIN
BCRYPT_ROUNDS=10
# Intentos fallidos antes de bloquear la cuenta, y minutos de bloqueo
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Superadmin inicial — se crea automáticamente al arrancar el servidor si no existe ninguno.
# Cambia el PIN por defecto apenas puedas iniciar sesión.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PIN=
